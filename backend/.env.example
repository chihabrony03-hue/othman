# ============================================================
#  MEEV backend configuration  (⚡ نسخة آمنة — احتفظ بها لنفسك)
#  انسخ هذا الملف إلى `.env` وعدّل القيم ثم شغّل الخادم.
# ============================================================

# --- Network -------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8080
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
TRUST_PROXY=false            # true فقط إذا كنت خلف Nginx/Cloudflare موثوق

# --- Database (PostgreSQL) -----------------------------------
# strong password — توليدها عبر: openssl rand -base64 32
DATABASE_URL=postgres://meev:_STRONG_DB_PASSWORD_@localhost:5432/meev
DB_MAX_CONNECTIONS=10
AUTO_MIGRATE=true

# --- Auth / JWT ----------------------------------------------
# يتم توليدها تلقائياً بواسطة scripts/gen-env.sh:
# openssl rand -base64 48   (يجب ألا تقل عن 32 حرفاً)
JWT_SECRET=_REPLACE_WITH_64_CHAR_RANDOM_SECRET_
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# --- Rate limit (DoS protection) ------------------------------
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# --- MQTT broker ----------------------------------------------
MQTT_ENABLED=true
MQTT_URL=tcp://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# --- Media / ffmpeg -------------------------------------------
# ⚠️ ضع هنا المسار الكامل لأداة ffmpeg على جهازك:
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
MAX_UPLOAD_MB=50
UPLOAD_DIR=./uploads
MEDIA_TIMEOUT_SECONDS=120

# --- Static frontend -------------------------------------------
STATIC_DIR=./static
MAX_MESSAGE_LENGTH=4000
MAX_ATTACHMENTS_PER_MESSAGE=1

# --- Logging ---------------------------------------------------
LOG_LEVEL=info
